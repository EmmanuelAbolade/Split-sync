{
  "name": "split-sync-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@paypal/react-paypal-js": "8.9.2",
    "@simplewebauthn/browser": "14.0.0",
    "@testing-library/dom": "10.4.1",
    "crypto-js": "4.2.0",
    "firebase": "12.6.0",
    "lucide-react": "0.555.0",
    "qrcode": "1.5.4",
    "qrcode.react": "4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.18.4",
    "react-scripts": "5.0.1",
    "recharts": "3.7.0",
    "tesseract.js": "7.0.0",
    "web-vitals": "2.1.4",
    "zustand": "5.0.8"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "test:rules": "firebase emulators:exec --only firestore --project demo-splitsync \"npm --prefix firestore-tests test\"",
    "test:functions": "node --test functions/iban.test.js functions/privateData.test.js functions/core/core.test.js",
    "test:functions:emulator": "firebase emulators:exec --only firestore --project demo-splitsync \"node --test functions/test/integration/*.test.js\""
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(firebase|@firebase)/)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/pages/Taskmaster.jsx",
      "src/components/CloudinaryUpload.jsx",
      "src/components/ContactSyncButton.jsx",
      "src/components/ReceiptScanner.jsx"
    ]
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "autoprefixer": "10.4.20",
    "jest-environment-jsdom": "30.2.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17"
  }
}
