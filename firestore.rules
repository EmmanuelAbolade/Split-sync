rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== ADMIN HELPER =====
    // Grants read access to users with { admin: true } Firebase custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ===== USERS COLLECTION =====
    // The public profile (name, photo, email, phone *hash*) is readable by any
    // signed-in user. Payment details and the plain phone number must NOT be
    // stored here; they live in users/{uid}/private/details (owner only).
    // Legacy docs may still hold them: an update may remove them, never add or
    // change them.
    function noPrivateFieldsWritten() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['paymentMethods', 'phoneNumber']) ||
        !request.resource.data.keys().hasAny(['paymentMethods', 'phoneNumber']);
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['paymentMethods', 'phoneNumber']);
      // Self-updates, plus admins toggling isActive (Taskmaster suspend/reactivate)
      allow update: if request.auth != null && (
        (request.auth.uid == userId && noPrivateFieldsWritten()) ||
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive']))
      );
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Private profile details — owner only (admins cannot read them either).
    // Other members get payment options through the getGroupPaymentMethods
    // Cloud Function, which checks group membership.
    match /users/{userId}/private/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== SUSPENSION HELPER =====
    // Users suspended by an admin (users/{uid}.isActive == false) cannot write
    // group data. A missing profile doc is treated as active.
    function notSuspended() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) != false;
    }
    
    // ===== MEMBERSHIP HELPER =====
    // True when the signed-in user is a current member of the group.
    // Leaving a group removes the user from memberIds, so leavers fail this.
    function isGroupMember(groupId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/groups/$(groupId)) &&
        request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    // A non-member joining via invite link may ONLY add themselves: memberIds
    // gains exactly their uid, members gains exactly one entry (theirs, appended
    // by arrayUnion), formerMembers may drop their old entry. Nothing else.
    function isSelfJoin() {
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['memberIds', 'members', 'formerMembers', 'updatedAt']) &&
        after.memberIds.toSet() == before.memberIds.toSet().union([request.auth.uid].toSet()) &&
        after.members.size() == before.members.size() + 1 &&
        after.members[after.members.size() - 1].userId == request.auth.uid &&
        before.get('type', 'shared') != 'personal';
    }

    // ===== GROUPS COLLECTION =====
    match /groups/{groupId} {
      // Read stays open to signed-in users so invite links can preview the group
      allow read: if request.auth != null;
      // Creator must be the requester and the only initial member
      allow create: if request.auth != null &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid];
      // Members can update; a non-member may only add themselves (joining via
      // invite link) — and personal trackers cannot be joined at all.
      allow update: if request.auth != null && notSuspended() && (
        request.auth.uid in resource.data.memberIds ||
        isSelfJoin()
      ) ||
      // Admin moderation (Taskmaster): may only rename a group
      (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'moderatedAt', 'moderatedBy']));
      // Only the owner deletes a group (or a sole remaining member, e.g. during
      // account deletion). Previously ANY member could delete the whole group.
      allow delete: if request.auth != null && (
        resource.data.createdBy == request.auth.uid ||
        (request.auth.uid in resource.data.memberIds && resource.data.members.size() == 1)
      );
    }

    // ===== EXPENSES COLLECTION =====
    // Reads and writes require current group membership (admins may read).
    // Previously any signed-in user could read, create, edit or delete any
    // expense in any group.
    match /expenses/{expenseId} {
      allow read: if isAdmin() || isGroupMember(resource.data.groupId);
      allow create: if isGroupMember(request.resource.data.groupId) && notSuspended() &&
        (!('createdBy' in request.resource.data) ||
          request.resource.data.createdBy == request.auth.uid);
      // An expense can never be moved to another group
      allow update: if (isGroupMember(resource.data.groupId) && notSuspended() &&
        request.resource.data.groupId == resource.data.groupId) ||
        // Admin moderation (Taskmaster): may only soft-remove an expense
        (isAdmin() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'deletedAt', 'deletedBy', 'moderated']) &&
         request.resource.data.status == 'deleted');
      allow delete: if isGroupMember(resource.data.groupId) && notSuspended();
    }
    
    // ===== CONNECTIONS =====
    match /connections/{userId}/connectedUsers/{connectedUserId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.uid == connectedUserId
      );
    }
    
    // ===== INVITATIONS =====
    match /invitations/{invitationId} {
      // Admin can read all invitations (e.g. to count pending invitations in Taskmaster)
      allow read: if isAdmin() ||
        (request.auth != null && 
         (resource.data.toUserId == request.auth.uid || 
          resource.data.fromUserId == request.auth.uid));
      
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.fromUserId;
      
      allow update: if request.auth != null && 
        resource.data.toUserId == request.auth.uid;
      
      // Sender, or an admin cleaning up expired invitations (Taskmaster)
      allow delete: if isAdmin() || (request.auth != null &&
        resource.data.fromUserId == request.auth.uid);
    }
    
    // ===== PHONE NUMBERS =====
    match /phoneNumbers/{hashedPhone} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // ===== NOTIFICATIONS =====
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
                   resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      // Owner may update their own notification. The other party to a payment
      // (payer/payee named in data) may update it for the confirm/decline flow,
      // but cannot change who it belongs to or the payment's amount/parties.
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        (
          (request.auth.uid == resource.data.get('data', {}).get('payerId', '') ||
           request.auth.uid == resource.data.get('data', {}).get('payeeId', '')) &&
          request.resource.data.userId == resource.data.userId &&
          request.resource.data.type == resource.data.type &&
          request.resource.data.get('data', {}).get('amount', 0) == resource.data.get('data', {}).get('amount', 0) &&
          request.resource.data.get('data', {}).get('payerId', '') == resource.data.get('data', {}).get('payerId', '') &&
          request.resource.data.get('data', {}).get('payeeId', '') == resource.data.get('data', {}).get('payeeId', '') &&
          request.resource.data.get('data', {}).get('groupId', '') == resource.data.get('data', {}).get('groupId', '')
        )
      );
      allow delete: if request.auth != null &&
                     resource.data.userId == request.auth.uid;
    }

    // ===== PENDING PAYMENTS =====
    // Stores in-progress payment records to prevent duplicate payments
    // across sessions and devices. Document ID: {groupId}_{fromUserId}_{toUserId}
    match /pendingPayments/{docId} {
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create, update: if request.auth != null &&
        request.resource.data.fromUserId == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    
    // ===== FALLBACK RULE (MUST BE LAST!) =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
