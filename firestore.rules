rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== USERS COLLECTION =====
    // Users can read any user data (for payment methods, photos, names)
    // Users can only write their own data
    match /users/{userId} {
      allow read: if request.auth != null; // Any authenticated user can read
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== GROUPS COLLECTION =====
    match /groups/{groupId} {
    allow read: if request.auth != null;
    allow create: if request.auth != null;
    
    // Allow update if:
    // 1. User is already a member (normal updates), OR
    // 2. User is joining (adding themselves to memberIds)
    allow update: if request.auth != null && (
      request.auth.uid in resource.data.memberIds  // Already a member
      || request.auth.uid in request.resource.data.memberIds  // Joining now
    );
    
    allow delete: if request.auth != null 
                && request.auth.uid in resource.data.memberIds;
  }
    
    // ===== EXPENSES COLLECTION =====
    // Expenses can be read/written by group members
    match /expenses/{expenseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // ===== FALLBACK RULE =====
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // NEW: Connections - users can read/write their own connections
    match /connections/{userId}/connectedUsers/{connectedUserId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // NEW: Invitations
    match /invitations/{invitationId} {
      // Users can read invitations they sent or received
      allow read: if request.auth != null && 
        (resource.data.toUserId == request.auth.uid || 
         resource.data.fromUserId == request.auth.uid);
      
      // Users can create invitations
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.fromUserId;
      
      // Users can update invitations they received (accept/decline)
      allow update: if request.auth != null && 
        resource.data.toUserId == request.auth.uid;
      
      // Users can delete invitations they sent
      allow delete: if request.auth != null && 
        resource.data.fromUserId == request.auth.uid;
    }
    
    // NEW: Phone Numbers (for contact matching)
    match /phoneNumbers/{hashedPhone} {
      // Anyone authenticated can read (for matching)
      allow read: if request.auth != null;
      
      // Users can create their own phone hash
      allow create: if request.auth != null;
      
      // Users can update their own phone hash
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Users can delete their own phone hash
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // UPDATED: Users collection (add allowContactSync field)
    match /users/{userId} {
      // ... existing rules ...
      
      // Allow users to update their contact sync preference
      allow update: if request.auth != null && 
        request.auth.uid == userId;
    }

    match /notifications/{notificationId} {
      allow read: if request.auth != null && 
                  resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
                           resource.data.userId == request.auth.uid;
    }
  }
}
