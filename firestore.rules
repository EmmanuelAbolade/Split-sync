rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== ADMIN HELPER =====
    // Grants read access to users with { admin: true } Firebase custom claim
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ===== USERS COLLECTION =====
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== GROUPS COLLECTION =====
    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.uid in request.resource.data.memberIds
      );
      allow delete: if request.auth != null && 
                    request.auth.uid in resource.data.memberIds;
    }
    
    // ===== EXPENSES COLLECTION =====
    match /expenses/{expenseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // ===== CONNECTIONS =====
    match /connections/{userId}/connectedUsers/{connectedUserId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && (
        request.auth.uid == userId || 
        request.auth.uid == connectedUserId
      );
    }
    
    // ===== INVITATIONS =====
    match /invitations/{invitationId} {
      // Admin can read all invitations (e.g. to count pending invitations in Taskmaster)
      allow read: if isAdmin() ||
        (request.auth != null && 
         (resource.data.toUserId == request.auth.uid || 
          resource.data.fromUserId == request.auth.uid));
      
      allow create: if request.auth != null && 
        request.auth.uid == request.resource.data.fromUserId;
      
      allow update: if request.auth != null && 
        resource.data.toUserId == request.auth.uid;
      
      allow delete: if request.auth != null && 
        resource.data.fromUserId == request.auth.uid;
    }
    
    // ===== PHONE NUMBERS =====
    match /phoneNumbers/{hashedPhone} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && 
        resource.data.userId == request.auth.uid;
    }
    
    // ===== NOTIFICATIONS =====
    match /notifications/{notificationId} {
      allow read: if request.auth != null &&
                   resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
                     resource.data.userId == request.auth.uid;
    }

    // ===== PENDING PAYMENTS =====
    // Stores in-progress payment records to prevent duplicate payments
    // across sessions and devices. Document ID: {groupId}_{fromUserId}_{toUserId}
    match /pendingPayments/{docId} {
      allow read: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create, update: if request.auth != null &&
        request.resource.data.fromUserId == request.auth.uid;
      allow delete: if request.auth != null && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
    }

    
    // ===== FALLBACK RULE (MUST BE LAST!) =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
