rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===== USERS COLLECTION =====
    // Users can read any user data (for payment methods, photos, names)
    // Users can only write their own data
    match /users/{userId} {
      allow read: if request.auth != null; // ✅ Any authenticated user can read
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // ===== GROUPS COLLECTION =====
    // Only group members can read group data
    // Only authenticated users can create groups
    // Only group members can update groups
    match /groups/{groupId} {
      allow read: if request.auth != null 
                  && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null;
      allow update: if request.auth != null 
                    && request.auth.uid in resource.data.memberIds;
      allow delete: if request.auth != null 
                    && request.auth.uid in resource.data.memberIds;
    }
    
    // ===== EXPENSES COLLECTION =====
    // Expenses can be read/written by group members
    match /expenses/{expenseId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // ===== FALLBACK RULE =====
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
